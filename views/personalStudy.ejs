      <button id="addContainer" class="toolBtn" title="Add Container">&#x2795;</button>
      <button id="timedContainer" class="toolBtn" title="Timed Container">&#x23F1;</button>
      <button id="removeContainer" class="toolBtn" title="Remove Container">&#x274C;</button>
      <button id="lockContainer" class="toolBtn" title="Lock/Unlock Container">&#x1F512;</button>
      <button id="zUp" class="toolBtn" title="Bring Forward">&#x25B2;</button>
      <button id="zDown" class="toolBtn" title="Send Backward">&#x25BC;</button>
    </div>

    <!-- ✍️ Text Controls -->
    <div class="toolGroup" aria-label="Text Controls">
      <button id="selectFont" class="toolBtn" title="Select Font">&#x1D504;</button>
      <button id="fontSizeUp" class="toolBtn" title="Increase Font Size">A+</button>
      <button id="fontSizeDown" class="toolBtn" title="Decrease Font Size">A−</button>
      <button id="boldToggle" class="toolBtn" title="Bold"><strong>B</strong></button>
      <button id="italicToggle" class="toolBtn" title="Italic"><em>I</em></button>
      <button id="underlineToggle" class="toolBtn" title="Underline"><u>U</u></button>
      <button id="textLeft" class="toolBtn" title="Align Left">&#x21E4;</button>
      <button id="textCenter" class="toolBtn" title="Align Center">&#x21C6;</button>
      <button id="textRight" class="toolBtn" title="Align Right">&#x21E5;</button>
      <button id="textPadding" class="toolBtn" title="Text Padding">&#x25A1;</button>
    </div>

    <!-- 🎨 Style Controls -->
    <div class="toolGroup" aria-label="Style Controls">
      <button id="colorSelection" class="toolBtn" title="Select Colors">&#x1F3A8;</button>
      <button id="borderContainer" class="toolBtn" title="Toggle Border">&#x25AD;</button>
      <button id="shadowToggle" class="toolBtn" title="Toggle Shadow">&#x1F4A1;</button>
      <button id="opacityControl" class="toolBtn" title="Opacity">&#x1F50C;</button>
    </div>

    <!-- 📤 Import/Export -->
    <div class="toolGroup" aria-label="Import/Export">
      <button id="exportHTML" class="toolBtn" title="Export HTML">&#x1F4C4;&#x2192;</button>
      <button id="importJSON" class="toolBtn" title="Import JSON">&#x2190;&#x1F4C4;</button>
    </div>

    <!-- 🧪 Dynamic Inputs -->
    <div id="controlInputs" class="panel hide">
      <input type="text" id="textInputs" class="inputField hide"
        pattern="^(?:([0-4]\d|5[0]):[0-5]\d:[0-5]\d|(?:150|1[0-4]\d|\d{1,2}))$"
        title="Enter time (HH:MM:SS) or number (0–150)"
        placeholder="Enter value..." />

      <!-- 🎨 Color Picker -->
      <div id="toggleHighlight" class="panel hide">
        <div class="colorControls">
          <div id="colorModeToggle" class="toggleGroup">
            <button id="toggleBg" class="toggleBtn active">BG</button>
            <button id="toggleTxt" class="toggleBtn">TXT</button>
          </div>
          <div id="colorGridWrapper">
            <div id="colorGrid" tabindex="0" role="grid"></div>
          </div>
          <div class="smalldesc">
            Tab to cycle colors <span id="coloredDot" title="Active">&#9900;</span>
          </div>
          <div id="highlightExample" class="highlighted">Sample highlighted text</div>
        </div>
      </div>

      <!-- ✍️ Font Selection -->
      <div id="font-selection" class="panel hide">
        <label for="font-select">Choose a font:</label>
        <select id="font-select" name="font" class="fontDropdown">
          <option value="" selected disabled>Selected Font</option>
          <option value="arial">Arial</option>
          <option value="helvetica">Helvetica</option>
          <option value="times-new-roman">Times New Roman</option>
          <option value="georgia">Georgia</option>
          <option value="courier-new">Courier New</option>
          <option value="verdana">Verdana</option>
          <option value="tahoma">Tahoma</option>
          <option value="trebuchet-ms">Trebuchet MS</option>
          <option value="lucida-console">Lucida Console</option>
          <option value="impact">Impact</option>
        </select>
      </div>
    </div>
  </div>
<!--end-->
	</main>
	<div id="data-container" 
		data-session='<%= session %>' 
		data-UUID='<%= uuid %>'>
	</div>
	<script src="../../javascript/personalStudy.js"></script>
</body>
</html>